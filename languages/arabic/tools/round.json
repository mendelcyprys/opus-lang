  {"t":"type","p":"Type in Arabic: \"The boys won't go tomorrow.\"","a":["الأولاد لن يذهبوا غدا","لن يذهب الأولاد غدا"],"tag":"typed لن يذهبوا غدا","model":"الأَوْلَادُ لَنْ يَذْهَبُوا غَدًا."},
